rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /menu/prices {
      allow get: if true; // Public menu can read prices without signing in.
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == 'xYTJRUX7bMMdIkoepGViPhmIrsw2'
        && request.resource.data.keys().hasOnly(['prices','updatedAt'])
        && request.resource.data.keys().hasAll(['prices','updatedAt'])
        && request.resource.data.prices is map;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
